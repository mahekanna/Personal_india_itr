# Never, ever commit tax documents or a returns database.
*.db
*.sqlite
*.sqlite3
.india-itr/
uploads/
# User data directories only — app/data holds the shipped rate table.
/data/

# Real tax documents, if anyone drops them in the tree by accident.
Form16*.pdf
*26AS*.pdf
AIS*.pdf
AIS*.json
*tradewise*
*capital_gain*.xlsx
!tests/fixtures/*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Demo artefacts: the JPEGs are committed for the README, the full-size PNGs
# and the generated JSON/PDF are not.
demo/screens/*.png
demo/output/

# Editors and OS
.vscode/
.idea/
.DS_Store
